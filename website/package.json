{
  "name": "complejo-mushuc-runa-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:node": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:php": "php backend/finados-api/tests/run.php",
    "test": "npm run test:node && npm run test:php",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "dev:voceros": "node tests/integration/local-stack.mjs",
    "check": "npm test && npm run test:integration && npm run build && node scripts/check-dist.mjs",
    "deploy:validate": "node scripts/deploy-cpanel.mjs --validate-config",
    "deploy:check": "node scripts/deploy-cpanel.mjs --check",
    "deploy": "node scripts/deploy-cpanel.mjs --deploy",
    "backend:validate": "node scripts/deploy-finados-backend.mjs --validate-config",
    "backend:check": "node scripts/deploy-finados-backend.mjs --check",
    "backend:deploy": "node scripts/deploy-finados-backend.mjs --deploy",
    "backend:admin": "node scripts/deploy-finados-backend.mjs --admin",
    "backend:import:check": "node scripts/deploy-finados-backend.mjs --import-check",
    "backend:import": "node scripts/deploy-finados-backend.mjs --import"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
