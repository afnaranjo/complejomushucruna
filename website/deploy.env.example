# Copia este archivo como website/.env.deploy y reemplaza solo los valores locales.
# Nunca confirmes website/.env.deploy ni una llave privada en Git.
DEPLOY_SSH_HOST=hosting.example.com
DEPLOY_SSH_USER=usuario_cpanel
DEPLOY_SSH_PORT=22
DEPLOY_SSH_KEY=/ruta/absoluta/a/id_rsa_complejo
DEPLOY_REMOTE_ROOT=/home/usuario_cpanel/public_html/complejomushucruna.com
DEPLOY_SITE_URL=https://complejomushucruna.com
# Opcional: configura ambos valores para sincronizar formularios con Google Sheets.
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/IMPLEMENTACION/exec
GOOGLE_SHEETS_TOKEN=TOKEN_HEXADECIMAL_DE_64_CARACTERES
